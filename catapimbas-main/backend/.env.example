# Copie para .env apenas no ambiente local. Nunca versione credenciais.
DATABASE_URL=postgres://usuario:senha@localhost:5432/integrador
JWT_SECRET=SUBSTITUA_POR_SEGREDO_ALEATORIO_GERADO_COM_OPENSSL
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# Opcional: CA PEM do Supabase codificado em base64 para validação de certificado.
# DB_SSL_CA_BASE64=BASE64_DO_CERTIFICADO_CA
DB_POOL_MAX=5
DB_STATEMENT_TIMEOUT_MS=15000
SQL_LOG=false
TRUST_PROXY=false

# Variáveis temporárias: usadas apenas ao executar npm run seed:superadmin.
# INITIAL_INSTITUTION_NAME=Instituição de Demonstração
# INITIAL_INSTITUTION_IDENTIFIER=demo
# SEED_ADMIN_NAME=Administrador Inicial
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=SUBSTITUA_POR_SENHA_FORTE

# Recuperação de senha por e-mail (Resend). Obrigatório para ativar o fluxo.
RESEND_API_KEY=
EMAIL_FROM=Nexus Academic <noreply@seu-dominio-verificado.com>
FRONTEND_URL=http://localhost:5173
